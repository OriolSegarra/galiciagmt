---
import { r, t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<section class="cta">
  <div class="wrap inner">
    <h2>{t(lang, 'cta.title')}</h2>
    <div>
      <p>{t(lang, 'cta.text')}</p>
      <a class="btn btn--sun" href={r(lang, 'asinao')}>{t(lang, 'cta.button')} →</a>
    </div>
  </div>
</section>

<style>
  .cta {
    background: var(--blue);
    color: var(--paper);
    margin-top: 5rem;
    padding-block: 3.5rem;
  }
  .inner {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 2rem;
    align-items: end;
  }
  h2 {
    margin: 0;
    font-size: clamp(2rem, 5vw, 3.4rem);
    line-height: 1;
    letter-spacing: -0.03em;
    font-weight: 800;
    max-width: 14ch;
  }
  p {
    margin: 0 0 1.4rem;
    max-width: 40ch;
    color: #d8e0ea;
  }
  @media (max-width: 760px) {
    .inner {
      grid-template-columns: 1fr;
    }
  }
</style>
