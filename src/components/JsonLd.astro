---
// Emite uno ou varios bloques JSON-LD. Escapa "<" para que o JSON non peche o <script>.
interface Props {
  data?: Record<string, unknown> | Record<string, unknown>[];
}
const { data } = Astro.props;
const list = data ? (Array.isArray(data) ? data : [data]) : [];
const blocks = list.map((d) => JSON.stringify(d).replace(/</g, '\\u003c'));
---

{blocks.map((b) => <script type="application/ld+json" set:html={b} />)}
