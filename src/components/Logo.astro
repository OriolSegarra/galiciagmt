---
/* Marca: un reloxo con dúas agullas separadas — a hora oficial e a hora do sol. */
---

<span class="logo">
  <svg viewBox="0 0 32 32" width="28" height="28" aria-hidden="true">
    <circle cx="16" cy="16" r="14.5" fill="none" stroke="currentColor" stroke-width="2"></circle>
    <line x1="16" y1="16" x2="16" y2="5" stroke="currentColor" stroke-width="2.4" stroke-linecap="square"></line>
    <line x1="16" y1="16" x2="9.2" y2="7.4" stroke="#e8a33d" stroke-width="2.4" stroke-linecap="square"></line>
    <circle cx="16" cy="16" r="2" fill="currentColor"></circle>
  </svg>
  <span class="word">Galicia<b>GMT</b></span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
  }
  .word {
    font-weight: 800;
    font-size: 1.15rem;
    letter-spacing: -0.02em;
  }
  .word b {
    font-weight: 400;
    margin-left: 0.1em;
  }
</style>
