---
import Base from '../layouts/Base.astro';
---

<Base lang="gl" title="Páxina non atopada">
  <section class="wrap nf">
    <p class="kicker">404</p>
    <h1>Esta páxina chegou tarde.<br />Como o sol en xaneiro.</h1>
    <p><a href="/">Volver á portada</a> · <a href="/es/">Ir a la portada en castellano</a></p>
  </section>
</Base>

<style>
  .nf {
    padding-block: 6rem 2rem;
  }
  h1 {
    font-size: clamp(2.2rem, 6vw, 4rem);
    letter-spacing: -0.04em;
    line-height: 1;
    margin: 0.8rem 0 1.5rem;
  }
</style>
