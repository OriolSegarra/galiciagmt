---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Fontes from '../components/Fontes.astro';
import Cta from '../components/Cta.astro';
import { articleUrl, formatDate, r, t, type Lang } from '../i18n/ui';
import { articleSchema, faqSchema } from '../lib/schema';
import { artigosDe, langOf, parDe, slugOf, type Artigo } from '../lib/artigos';

interface Props {
  entry: Artigo;
}
const { entry } = Astro.props;
const lang: Lang = langOf(entry);
const other = await parDe(entry);
const otherLang: Lang = lang === 'gl' ? 'es' : 'gl';
const alt = other ? articleUrl(otherLang, slugOf(other)) : r(otherLang, 'artigos');
const { Content } = await render(entry);
const d = entry.data;

const path = articleUrl(lang, slugOf(entry));
const schema = [
  articleSchema({ lang, path, titulo: d.titulo, entradilla: d.entradilla, data: d.data, actualizado: d.actualizado }),
  ...(d.par === 'faq' ? [faqSchema(lang, entry.body ?? '')] : []),
];

const all = await artigosDe(lang);
const idx = all.findIndex((a) => a.id === entry.id);
const more = [1, 2, 3].map((i) => all[(idx + i) % all.length]).filter((a) => a.id !== entry.id);
---

<Base lang={lang} title={d.titulo} description={d.entradilla} alt={alt} type="article" schema={schema}>
  <article class="wrap art">
    <header class="head">
      <p class="kicker">
        <a href={r(lang, 'artigos')}>{t(lang, 'nav.artigos')}</a>
        <span aria-hidden="true">/</span>
        {t(lang, `section.${d.seccion}` as const)}
      </p>
      <h1>{d.titulo}</h1>
      <p class="lede">{d.entradilla}</p>
      <dl class="meta">
        <div>
          <dt>{t(lang, 'article.published')}</dt>
          <dd><time datetime={d.data.toISOString()}>{formatDate(lang, d.data)}</time></dd>
        </div>
        {
          d.actualizado && (
            <div>
              <dt>{t(lang, 'article.updated')}</dt>
              <dd>
                <time datetime={d.actualizado.toISOString()}>{formatDate(lang, d.actualizado)}</time>
              </dd>
            </div>
          )
        }
        <div>
          <dt>{t(lang, 'article.sources')}</dt>
          <dd><a href="#fontes">{d.fontes.length}</a></dd>
        </div>
        {
          other && (
            <div>
              <dt>{otherLang.toUpperCase()}</dt>
              <dd>
                <a href={alt} hreflang={otherLang}>
                  {t(lang, 'article.other')}
                </a>
              </dd>
            </div>
          )
        }
      </dl>
    </header>

    <div class="prose">
      <Content />
    </div>

    <Fontes lang={lang} fontes={d.fontes} />

    {
      more.length > 0 && (
        <nav class="more" aria-labelledby="more-h">
          <h2 id="more-h" class="kicker">{t(lang, 'article.more')}</h2>
          <ul>
            {more.map((a) => (
              <li>
                <a href={articleUrl(lang, slugOf(a))}>{a.data.titulo}</a>
              </li>
            ))}
            <li>
              <a href={r(lang, 'amencer')}>{t(lang, 'article.tool')}</a>
            </li>
            <li>
              <a href={r(lang, 'asinao')}>{t(lang, 'cta.button')}</a>
            </li>
          </ul>
        </nav>
      )
    }
  </article>
  <Cta lang={lang} />
</Base>

<style>
  .art {
    padding-top: 3rem;
  }
  .head {
    max-width: 52rem;
    margin-bottom: 3rem;
  }
  .kicker a {
    text-decoration: none;
    color: inherit;
  }
  .kicker span {
    margin-inline: 0.4em;
  }
  h1 {
    margin: 1rem 0 1.2rem;
    font-size: clamp(2.2rem, 5.6vw, 4rem);
    line-height: 1;
    letter-spacing: -0.04em;
    font-weight: 800;
  }
  .lede {
    font-size: clamp(1.15rem, 2vw, 1.35rem);
    line-height: 1.45;
    color: var(--ink-2);
    margin: 0 0 1.8rem;
    max-width: 46ch;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2.2rem;
    margin: 0;
    padding-top: 0.9rem;
    border-top: 1px solid var(--ink);
    font-size: 0.875rem;
  }
  .meta dt {
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 700;
  }
  .meta dd {
    margin: 0.1rem 0 0;
    font-weight: 600;
  }
  .more {
    margin-top: 3rem;
    padding-top: 1rem;
    border-top: 1px solid var(--ink);
    max-width: var(--measure);
  }
  .more h2 {
    margin: 0 0 0.6rem;
  }
  .more ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .more li {
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .more a {
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.2;
    text-decoration: none;
  }
  .more a:hover {
    text-decoration: underline;
  }
</style>
