  .top, .todos { margin-top: 3.5rem; }
  .top h2, .todos h2 { font-size: clamp(1.3rem, 3.4vw, 1.9rem); letter-spacing: -0.03em; line-height: 1.1; margin: 0 0 0.6rem; max-width: 40ch; }
  .sub { margin: 0 0 1.2rem; color: var(--ink-2); max-width: 62ch; font-size: 0.95rem; }
  .top2 { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem 3rem; }
  caption { text-align: left; padding-bottom: 0.4rem; }
  .pv { display: block; font-weight: 400; font-size: 0.78rem; color: var(--muted); }
  tbody th a { color: inherit; }

  details { border-top: 1px solid var(--ink); }
  details:last-of-type { border-bottom: 1px solid var(--ink); }
  summary { cursor: pointer; padding: 0.8rem 0; font-weight: 800; font-size: 1.15rem; letter-spacing: -0.01em; }
  summary .n { font-weight: 400; font-size: 0.85rem; color: var(--ink-2); margin-left: 0.4rem; }
  .lt { font-size: 0.88rem; margin-bottom: 1rem; }
  .lt thead th { text-align: left; }
  .lt th[scope='row'] { font-weight: 500; }

  .notes { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; margin-top: 3rem; font-size: 0.95rem; color: var(--ink-2); }
  .notes h2 { margin: 0 0 0.6rem; }
  .notes p { margin: 0 0 0.8rem; }
  .notes ul { padding-left: 1.1rem; margin: 0; }
  .notes li + li { margin-top: 0.4rem; }

  @media (max-width: 760px) {
    .grid, .top2, .notes { grid-template-columns: 1fr; gap: 1.5rem; }
    .ctrl { grid-template-columns: 1fr; }
    .lt { font-size: 0.8rem; }
    .lt th, .lt td { padding-right: 0.35rem; }
    td.big { font-size: 1.15rem; }
