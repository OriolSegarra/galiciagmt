---
import Base from '../layouts/Base.astro';
import { r, t, type Lang } from '../i18n/ui';
import { TALLY_FORM_ID } from '../config';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const c = {
  gl: {
    h1: 'Asínao',
    lede: 'Unha sinatura non cambia a hora. Pero serve para demostrar que hai xente disposta a abrir o debate con datos, e iso é o primeiro paso para que un concello, o Parlamento de Galicia ou o Goberno o poñan na axenda.',
    what: 'Que asinas',
    points: [
      'Que Galicia estude en serio recuperar a hora de Greenwich (a mesma de Portugal e Canarias).',
      'Ou, como mínimo, que se deixe de adiantar o reloxo cada primavera.',
      'Que calquera decisión se tome con estudos públicos e escoitando tamén os argumentos en contra.',
    ],
    privacy:
      'Só pedimos nome, concello e correo. Non cedemos datos a terceiros nin os usamos para nada que non sexa contar apoios e, se o marcas, avisarte de novidades.',
    pending: 'O formulario abrirase moi pronto.',
    pendingText: 'Estamos a preparar o sistema de sinaturas. Mentres tanto, a mellor forma de axudar é ler e compartir os artigos.',
    read: 'Ler os artigos',
    count: 'Non publicaremos contadores ata ter un sistema que evite sinaturas duplicadas. Preferimos poucas e reais.',
  },
  es: {
    h1: 'Fírmalo',
    lede: 'Una firma no cambia la hora. Pero sirve para demostrar que hay gente dispuesta a abrir el debate con datos, y ese es el primer paso para que un ayuntamiento, el Parlamento de Galicia o el Gobierno lo pongan en la agenda.',
    what: 'Qué firmas',
    points: [
      'Que Galicia estudie en serio recuperar la hora de Greenwich (la misma de Portugal y Canarias).',
      'O, como mínimo, que se deje de adelantar el reloj cada primavera.',
      'Que cualquier decisión se tome con estudios públicos y escuchando también los argumentos en contra.',
    ],
    privacy:
      'Solo pedimos nombre, municipio y correo. No cedemos datos a terceros ni los usamos para nada que no sea contar apoyos y, si lo marcas, avisarte de novedades.',
    pending: 'El formulario se abrirá muy pronto.',
    pendingText: 'Estamos preparando el sistema de firmas. Mientras tanto, la mejor forma de ayudar es leer y compartir los artículos.',
    read: 'Leer los artículos',
    count: 'No publicaremos contadores hasta tener un sistema que evite firmas duplicadas. Preferimos pocas y reales.',
  },
}[lang];

const tallySrc = TALLY_FORM_ID
  ? `https://tally.so/embed/${TALLY_FORM_ID}?alignLeft=1&hideTitle=1&transparentBackground=1&dynamicHeight=1`
  : '';
---

<Base lang={lang} title={t(lang, 'nav.asinao')} alt={r(lang === 'gl' ? 'es' : 'gl', 'asinao')}>
  <div class="wrap page">
    <header>
      <h1>{c.h1}</h1>
      <p class="lede">{c.lede}</p>
      <h2 class="kicker">{c.what}</h2>
      <ol class="points">
        {c.points.map((p) => <li>{p}</li>)}
      </ol>
      <p class="small">{c.privacy}</p>
      <p class="small">{c.count}</p>
    </header>

    <section class="form">
      {
        tallySrc ? (
          <>
            <iframe
              data-tally-src={tallySrc}
              src={tallySrc}
              loading="lazy"
              width="100%"
              height="620"
              frameborder="0"
              title={c.h1}
            />
            <script is:inline async src="https://tally.so/widgets/embed.js" />
          </>
        ) : (
          <div class="pending">
            <p class="kicker">{c.h1}</p>
            <p class="big">{c.pending}</p>
            <p>{c.pendingText}</p>
            <a class="btn" href={r(lang, 'artigos')}>
              {c.read} →
            </a>
          </div>
        )
      }
    </section>
  </div>
</Base>

<style>
  .page {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    padding-top: 3.5rem;
  }
  h1 {
    margin: 0 0 1.2rem;
    font-size: clamp(3rem, 9vw, 6.5rem);
    letter-spacing: -0.05em;
    line-height: 0.9;
    font-weight: 800;
  }
  .lede {
    font-size: 1.2rem;
    color: var(--ink-2);
    max-width: 42ch;
    margin: 0 0 2.2rem;
  }
  .points {
    margin: 0.8rem 0 2rem;
    padding: 0;
    list-style: none;
    counter-reset: p;
    border-top: 1px solid var(--ink);
  }
  .points li {
    counter-increment: p;
    padding: 0.8rem 0 0.8rem 2rem;
    border-bottom: 1px solid var(--rule);
    position: relative;
    font-weight: 600;
  }
  .points li::before {
    content: counter(p);
    position: absolute;
    left: 0;
    font-weight: 800;
    color: var(--sun);
  }
  .small {
    font-size: 0.875rem;
    color: var(--muted);
    max-width: 50ch;
  }
  .form {
    border-top: 3px solid var(--ink);
    padding-top: 1rem;
  }
  .pending {
    background: var(--paper-2);
    padding: 2rem;
  }
  .pending .big {
    font-size: 1.8rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin: 0.6rem 0 0.8rem;
  }
  .pending p {
    margin: 0 0 1.4rem;
  }
  @media (max-width: 860px) {
    .page {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
